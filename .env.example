EDGE_BETA_SMTP_HOST=mail.example.com
EDGE_BETA_SMTP_PORT=587
EDGE_BETA_SMTP_USER=beta@example.com
EDGE_BETA_SMTP_PASSWORD=replace-with-a-secret
EDGE_BETA_FROM_EMAIL=SaaSolution Drive Beta <beta@example.com>
EDGE_BETA_APPLICATION_EMAIL=beta@example.com

# Consultation requests (/api/consultation). Recipient defaults to the published hello@saasolution.es.
CONSULTATION_SMTP_HOST=mail.example.com
CONSULTATION_SMTP_PORT=587
CONSULTATION_SMTP_USER=consulting@example.com
CONSULTATION_SMTP_PASSWORD=replace-with-a-secret
CONSULTATION_FROM_EMAIL=SaaSolution Consulting <consulting@example.com>
CONSULTATION_TO_EMAIL=hello@saasolution.es
